{
  "[dockercompose]": {
    "editor.autoIndent": "advanced",
    "editor.defaultFormatter": "redhat.vscode-yaml",
    "editor.insertSpaces": true,
    "editor.quickSuggestions": {
      "comments": false,
      "other": true,
      "strings": true,
    },
    "editor.tabSize": 2,
  },
  "[github-actions-workflow]": {
    "editor.defaultFormatter": "redhat.vscode-yaml",
  },
  "[go]": {
    "editor.defaultFormatter": "golang.go",
  },
  "[markdown]": {
    "editor.wordWrap": "on",
  },
  "[python]": {
    "editor.defaultFormatter": "charliermarsh.ruff",
  },
  "[toml]": {
    "editor.defaultFormatter": "tamasfe.even-better-toml",
  },
  "aws.samcli.enableCodeLenses": true,
  "aws.samcli.location": "/usr/local/bin/sam",
  "aws.telemetry": false,
  "chat.agent.enabled": true,
  "chat.agentsControl.enabled": "hidden",
  "chat.mcp.autostart": "newAndOutdated",
  "chat.mcp.gallery.enabled": true,
  "chat.unifiedAgentsBar.enabled": true,
  "chat.viewSessions.orientation": "stacked",
  "claudeCode.preferredLocation": "sidebar",
  "containers.containerClient": "com.microsoft.visualstudio.containers.docker",
  "docker.extension.enableComposeLanguageServer": false,
  "editor.codeActionsOnSave": {
    "source.fixAll": "explicit",
    "source.organizeImports": "explicit",
  },
  "editor.defaultFormatter": "oxc.oxc-vscode",
  "editor.fontFamily": "'JetBrains Mono', Menlo, Monaco, 'Courier New', monospace",
  "editor.fontLigatures": true,
  "editor.formatOnSave": true,
  "editor.inlineSuggest.enabled": true,
  "editor.minimap.enabled": false,
  "editor.quickSuggestions": {
    "comments": "off",
    "other": "on",
    "strings": "on",
  },
  "explorer.autoReveal": false,
  "extensions.experimental.affinity": {
    "asvetliakov.vscode-neovim": 1,
  },
  "files.associations": {
    "*.css": "tailwindcss",
  },
  "files.exclude": {
    "**/__pycache__": true,
  },
  "files.insertFinalNewline": true,
  "github.copilot.chat.agent.thinkingTool": true,
  "github.copilot.enable": {
    "*": true,
    "plaintext": false,
    "scminput": false,
  },
  "github.copilot.nextEditSuggestions.enabled": false,
  "gitlens.codeLens.enabled": false,
  "gitlens.rebaseEditor.openOnPausedRebase": false,
  "go.inlayHints.assignVariableTypes": true,
  "go.inlayHints.compositeLiteralFields": true,
  "go.inlayHints.compositeLiteralTypes": true,
  "go.inlayHints.constantValues": true,
  "go.inlayHints.functionTypeParameters": true,
  "go.inlayHints.ignoredError": true,
  "go.inlayHints.parameterNames": true,
  "go.inlayHints.rangeVariableTypes": true,
  "go.toolsManagement.autoUpdate": true,
  "hediet.vscode-drawio.resizeImages": null,
  "js/ts.inlayHints.functionLikeReturnTypes.enabled": true,
  "js/ts.inlayHints.parameterNames.enabled": "literals",
  "js/ts.inlayHints.parameterTypes.enabled": true,
  "js/ts.inlayHints.variableTypes.enabled": true,
  "js/ts.updateImportsOnFileMove.enabled": "always",
  "notebook.formatOnSave.enabled": true,
  "notebook.lineNumbers": "on",
  "notebook.output.wordWrap": true,
  "python.analysis.autoImportCompletions": true,
  "python.analysis.exclude": [
    "**/.venv",
    "**/node_modules",
    "**/__pycache__",
    "**/.*",
  ],
  "python.analysis.fixAll": ["source.unusedImports"],
  "python.analysis.inlayHints.callArgumentNames": "partial",
  "python.analysis.inlayHints.functionReturnTypes": true,
  "python.analysis.inlayHints.pytestParameters": true,
  "python.analysis.inlayHints.variableTypes": true,
  "python.analysis.supportAllPythonDocuments": true,
  "python.analysis.typeCheckingMode": "standard",
  "python.languageServer": "Pylance",
  "python.terminal.shellIntegration.enabled": true,
  "ruff.exclude": [".venv"],
  "tailwindCSS.emmetCompletions": true,
  "terminal.external.osxExec": "ghostty.app",
  "terminal.integrated.fontFamily": "'JetBrains Mono', 'Hack Nerd Font Propo', 'MesloLGS NF', Menlo, Monaco, 'Courier New', monospace",
  "ty.disableLanguageServices": true,
  "vim.vimrc.enable": true,
  "workbench.colorTheme": "Dark Modern",
  "workbench.editor.useModal": "some",
  "workbench.iconTheme": "material-icon-theme",
  "yaml.schemas": {
    "file:///Users/takuro/.vscode/extensions/docsmsft.docs-yaml-1.0.6/dist/toc.schema.json": "/toc\\.yml/i"
  },
  "json.schemaDownload.trustedDomains": {
    "https://developer.microsoft.com/json-schemas/": true,
    "https://json-schema.org/": true,
    "https://json.schemastore.org/": true,
    "https://raw.githubusercontent.com/devcontainers/spec/": true,
    "https://raw.githubusercontent.com/microsoft/vscode/": true,
    "https://schemastore.azurewebsites.net/": true,
    "https://ui.shadcn.com/schema.json": true,
    "https://www.schemastore.org/": true
  },
}
